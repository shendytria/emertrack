# EMERTRACK — Environment Variables


# -----------------------------------------------------------------------------
# BACKEND
# -----------------------------------------------------------------------------

# Backend Port (host & container — used directly in docker-compose.yml)
BACKEND_PORT=8080

# Connection to PostgreSQL
DATABASE_URL=postgres://postgres:postgres@emertrack-db:5432/emertrack?sslmode=disable

# Secret key for signing JWT
JWT_SECRET=supersecretjwtkey


# -----------------------------------------------------------------------------
# SMTP (Email)
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=CHANGE_ME
SMTP_FROM=no-reply@yourdomain.com


# -----------------------------------------------------------------------------
# S3 / MinIO (Object Storage)
# -----------------------------------------------------------------------------

S3_ENDPOINT=http://emertrack-minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=emertrack
S3_REGION=us-east-1


# -----------------------------------------------------------------------------
# DATABASE (docker-compose.yml)
# -----------------------------------------------------------------------------

# Password postgres — harus sama dengan yang ada di DATABASE_URL di atas
DB_PASSWORD=postgres

# Host port for PostgreSQL — mapped in docker-compose.yml
DB_PORT=5432


RUN_SEEDER=true

SEED_SITE_CODE=SFL
SEED_SITE_NAME=Saka Farma Laboratories
SEED_DEPT_CODE=QS
SEED_DEPT_NAME=Quality System (QS)
SEED_ADMIN_NIK=0000000001
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@kalbeconsumerhealth.co.id
SEED_ADMIN_PASSWORD=Emertrack2026

# EMAIL Emertrack
NEXT_PUBLIC_EMAIL_EMERTRACK=admin@kalbeconsumerhealth.co.id

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------

# Backend URL
NEXT_PUBLIC_API_URL=https://192.168.4.141:8443/api/v1

# Bucket URL
NEXT_PUBLIC_MINIO_URL=https://192.168.4.141:8443/storage

# Frontend URL
FRONTEND_BASE_URL=https://192.168.4.141:8443

# Port database 
DB_PORT=5432

# Port MinIO API & Console di host
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Host & container port for frontend
FRONTEND_PORT=3000


# -----------------------------------------------------------------------------
# NGINX
# -----------------------------------------------------------------------------

# Host port exposed for HTTPS
NGINX_HTTPS_PORT=8443

# server_name in nginx.conf 
NGINX_SERVER_NAME=localhost
